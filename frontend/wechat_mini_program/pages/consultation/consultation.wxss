/* consultation.wxss */
.container {
  padding: 0 30rpx 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面标题 */
.page-header {
  padding: 40rpx 0 30rpx;
  text-align: center;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #666;
}

/* 快速咨询区域 */
.quick-consult-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.quick-consult-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.consult-item {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;
}

.consult-item:active {
  transform: scale(0.95);
}

.consult-icon {
  font-size: 48rpx;
  margin-bottom: 15rpx;
}

.consult-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.consult-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 咨询历史区域 */
.history-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-more {
  font-size: 26rpx;
  color: #1890ff;
}

.history-list {
  margin-bottom: 20rpx;
}

.history-item {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;
}

.history-item:active {
  transform: scale(0.98);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.history-type {
  background-color: #e6f7ff;
  color: #1890ff;
  padding: 6rpx 12rpx;
  border-radius: 15rpx;
  font-size: 22rpx;
}

.history-date {
  font-size: 24rpx;
  color: #999;
}

.history-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.history-preview {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.history-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-status {
  font-size: 24rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.history-status.active {
  background-color: #f6ffed;
  color: #52c41a;
}

.history-status.completed {
  background-color: #f0f0f0;
  color: #666;
}

.history-status.pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

.history-messages {
  font-size: 24rpx;
  color: #999;
}

/* 专家推荐区域 */
.expert-section {
  margin-bottom: 40rpx;
}

.expert-card {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: flex-start;
}

.expert-avatar {
  font-size: 60rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.expert-info {
  flex: 1;
}

.expert-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.expert-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 15rpx;
}

.expert-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  background-color: #f0f9ff;
  color: #1890ff;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.expert-status {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 15rpx;
  flex-shrink: 0;
}

.expert-status.online {
  background-color: #f6ffed;
  color: #52c41a;
}

/* 温馨提示区域 */
.tips-section {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 15rpx;
}

.tips-content {
  line-height: 1.6;
}

.tip-item {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 25rpx;
  opacity: 0.3;
}

.empty-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
}

.type-list {
  padding: 20rpx 0;
}

.type-item {
  display: flex;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.type-item:active {
  background-color: #f5f5f5;
}

.type-item:last-child {
  border-bottom: none;
}

.type-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.type-info {
  flex: 1;
}

.type-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.type-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.type-arrow {
  font-size: 28rpx;
  color: #ccc;
  flex-shrink: 0;
}