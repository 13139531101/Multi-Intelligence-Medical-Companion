/**consultation.wxss**/
.container {
  padding: 20rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
  transition: transform 0.3s ease;
  /* 允许侧边栏推动内容 */
  position: relative;
  left: 0;
}

.container.sidebar-open {
  /* 侧边栏打开时，主容器向右移动 */
  transform: translateX(70%);
  /* 防止主内容滚动 */
  height: 100vh;
  overflow: hidden;
}

/* 页面头部 */
.page-header {
  padding: 20rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  color: #333;
  padding: 10rpx;
}

.header-title-group {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.page-desc {
  font-size: 26rpx;
  color: #666;
}

/* 新建对话按钮 */
.new-consult-btn {
  background: #007aff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
}

.plus-icon {
  font-size: 48rpx;
  color: white;
  margin-right: 16rpx;
  line-height: 1;
  font-weight: 300;
}

.btn-text {
  font-size: 32rpx;
  color: white;
  font-weight: 600;
}

.new-consult-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 区域通用样式 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-more {
  font-size: 24rpx;
  color: #007aff;
}

/* 快速咨询区域 */
.quick-consult-section {
  margin-bottom: 40rpx;
}

.quick-consult-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.consult-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.consult-icon {
  font-size: 50rpx;
  margin-bottom: 16rpx;
}

.consult-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.consult-desc {
  font-size: 22rpx;
  color: #999;
}

/* 专家推荐区域 */
.expert-section {
  margin-bottom: 40rpx;
}

.expert-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.expert-avatar {
  width: 100rpx;
  height: 100rpx;
  background: #f0f7ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-right: 24rpx;
}

.expert-info {
  flex: 1;
}

.expert-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.expert-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.expert-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  font-size: 20rpx;
  color: #666;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.expert-status {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.expert-status.online {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.1);
}

/* 温馨提示区域 */
.tips-section {
  background: #fffbe6;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #faad14;
  margin-bottom: 12rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-item {
  font-size: 22rpx;
  color: #8c8c8c;
}

/* 侧边栏样式 */
.sidebar {
  position: fixed;
  top: 0;
  left: -70%; /* 初始隐藏 */
  width: 70%;
  height: 100%;
  background: white;
  z-index: 1001;
  transition: left 0.3s ease;
  box-shadow: 4rpx 0 16rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
}

.sidebar.open {
  left: 0;
}

.sidebar-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8f9fa;
}

.sidebar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.close-icon {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
}

.sidebar-content {
  flex: 1;
  overflow-y: auto;
  padding: 0;
}

.history-item-sidebar {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item-sidebar:active {
  background: #f9f9f9;
}

.sidebar-item-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sidebar-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.history-delete-btn {
  font-size: 22rpx;
  color: #ff3b30;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 59, 48, 0.08);
}

.history-delete-btn:active {
  background: rgba(255, 59, 48, 0.14);
}

.history-type-tag {
  font-size: 22rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.history-date-small {
  font-size: 22rpx;
  color: #999;
}

.history-preview-small {
  font-size: 26rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.empty-sidebar {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 2000; /* 高于侧边栏 */
}

.modal-content {
  width: 100%;
  background: white;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
}

.modal-body {
  padding: 20rpx 0;
  max-height: 800rpx;
  overflow-y: auto;
}

.type-list {
  padding: 0 30rpx;
}

.type-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.type-item:last-child {
  border-bottom: none;
}

.type-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  width: 80rpx;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-info {
  flex: 1;
}

.type-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.type-desc {
  font-size: 24rpx;
  color: #999;
}

.type-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 咨询输入框样式 */
.consult-input {
  width: calc(100% - 60rpx);
  height: 300rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
  margin: 0 30rpx;
}

.modal-footer {
  padding: 20rpx 30rpx 40rpx;
  display: flex;
  gap: 20rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: #007aff;
  color: white;
}

.btn-confirm:active {
  opacity: 0.9;
}

.btn-cancel:active {
  background: #eeeeee;
}
