<!--index.wxml-->
<view class="container">
  <!-- 快速操作：只保留健康咨询 -->
  <view class="section">
    <view class="section-title">健康服务</view>
    <view class="quick-actions">
      <view class="action-item consultation-item" bindtap="goToConsultation">
        <view class="action-icon">🩺</view>
        <view class="action-title">健康咨询</view>
        <view class="action-desc">AI智能健康咨询服务</view>
        <view class="action-count">新</view>
      </view>
    </view>
  </view>

  <!-- 最近活动 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">最近活动</view>
      <view class="section-more" bindtap="viewMoreActivities">查看全部</view>
    </view>
    <scroll-view class="activity-scroll" scroll-y="true" wx:if="{{recentActivities.length > 0}}">
      <view class="activity-list">
        <view class="activity-item" wx:for="{{recentActivities}}" wx:key="id">
          <view class="activity-icon">{{item.icon}}</view>
          <view class="activity-content">
            <view class="activity-title">{{item.title}}</view>
            <view class="activity-time">{{item.time}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="empty-state" wx:else>
      <view class="empty-icon">📝</view>
      <view class="empty-text">暂无最近活动</view>
    </view>
  </view>

  <!-- 健康趋势 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">健康趋势</view>
      <view class="section-more" bindtap="refreshTrends">刷新</view>
    </view>
    <view wx:if="{{trendLoading}}" class="trend-empty">趋势加载中</view>
    <view wx:elif="{{trendIndicators.length === 0}}" class="trend-empty">
      {{trendError || '暂无趋势数据'}}
    </view>
    <scroll-view wx:else class="trend-scroll" scroll-y="true">
      <view class="trend-list">
        <view
          class="trend-item {{trendSelectedName === item.name ? 'trend-item-active' : ''}}"
          wx:for="{{trendIndicators}}"
          wx:for-item="item"
          wx:key="name"
          data-name="{{item.name}}"
          bindtap="selectTrendIndicator"
        >
          <view class="trend-item-main">
            <view class="trend-item-name">{{item.name}}</view>
            <view class="trend-item-latest">{{item.latestText}}</view>
          </view>
          <view class="trend-item-meta">
            <view class="trend-item-count">共{{item.count}}条</view>
            <view class="trend-item-stats" wx:if="{{item.statsText}}">
              {{item.statsText}}
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{trendSelected}}" class="trend-detail">
      <view class="trend-detail-title">{{trendSelected.name}}趋势明细</view>
      <view class="trend-detail-sub" wx:if="{{trendSelected.stats}}">
        均值 {{trendSelected.stats.avg}} ｜ 最低 {{trendSelected.stats.min}} ｜ 最高 {{trendSelected.stats.max}}
      </view>
      <view wx:if="{{trendSelected.chartEnabled}}" class="trend-chart-canvas-wrap">
        <canvas
          canvas-id="trendChart"
          id="trendChart"
          class="trend-chart-canvas"
          style="width: {{trendChartW}}px; height: {{trendChartH}}px;"
          width="{{trendChartW}}"
          height="{{trendChartH}}"
        ></canvas>
      </view>
      <view wx:elif="{{trendSelected.count > 0}}" class="trend-chart-empty">
        数据点不足，暂无法绘制趋势图
      </view>
      <scroll-view class="trend-detail-scroll" scroll-y="true">
        <view class="trend-point-list">
          <view
            class="trend-point-item"
            wx:for="{{trendSelected.points}}"
            wx:for-item="point"
            wx:key="id"
          >
            <view class="trend-point-value">{{point.valueText}}</view>
            <view class="trend-point-meta">
              <text>{{point.date}}</text>
              <text wx:if="{{point.source}}"> · {{point.source}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 系统状态 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">系统状态</view>
      <view class="section-more" bindtap="refreshData">刷新</view>
    </view>
    <view class="status-item">
      <view class="status-label">API连接状态</view>
      <view class="status-value {{apiStatus === 'Connected' ? 'status-success' : 'status-error'}}">
        {{apiStatus}}
      </view>
    </view>
    <view class="status-item" wx:if="{{loginUserInfo}}">
      <view class="status-label">当前用户</view>
      <view class="status-value status-info">{{loginUserInfo.username || '已登录'}}</view>
    </view>
  </view>

  <!-- 悬浮AI助手按钮 (默认/分诊) -->
  <floating-ai-btn agent-type="host" />
</view>
