/**index.wxss**/
.container {
  padding: 30rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

/* 区域标题 */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* 区域头部通用样式 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 10rpx;
}

.section-more {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 区域容器 */
.section {
  margin-bottom: 48rpx;
  background: var(--card-bg);
  border-radius: var(--border-radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
}

.section:active {
  box-shadow: var(--shadow-md);
  transform: scale(0.99);
}

/* 快速操作区域 */
.quick-actions {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.action-item {
  background: var(--card-bg);
  border-radius: var(--border-radius-lg);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  width: 100%;
  box-shadow: var(--shadow-md);
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.action-item.consultation-item {
  background: linear-gradient(135deg, #ffffff 0%, #EFF6FF 100%);
  border: 1rpx solid rgba(79, 70, 229, 0.1);
}

.action-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 40rpx; /* Squircle */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-size: 56rpx;
  background: var(--bg-color);
  transition: all 0.3s ease;
}

.consultation-item .action-icon {
  background: var(--primary-gradient);
  box-shadow: var(--shadow-primary);
  color: white;
}

.action-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.action-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.5;
}

.action-count {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: var(--danger-color);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(255, 59, 48, 0.3);
}

/* 最近活动区域 */
.activity-scroll {
  max-height: 360rpx;
}

.activity-list {
  display: flex;
  flex-direction: column;
}

.activity-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.activity-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.activity-item:first-child {
  padding-top: 0;
}

.activity-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--bg-color);
  border-radius: var(--border-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-size: 36rpx;
}

.activity-content {
  flex: 1;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.activity-time {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 健康趋势 */
.trend-chart {
  display: flex;
  align-items: center;
  background: linear-gradient(to right, #f8f9fa, #fff);
  padding: 24rpx;
  border-radius: var(--border-radius-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.trend-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 122, 255, 0.05);
  border-radius: 50%;
}

.trend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.trend-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

.trend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.trend-scroll {
  max-height: 420rpx;
}

.trend-item {
  padding: 24rpx;
  border-radius: var(--border-radius-sm);
  background: rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.trend-item-active {
  border-color: rgba(0, 122, 255, 0.3);
  background: rgba(0, 122, 255, 0.06);
}

.trend-item-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.trend-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.trend-item-latest {
  font-size: 24rpx;
  color: var(--text-sub);
}

.trend-item-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.trend-item-count {
  font-size: 24rpx;
  color: var(--primary-color);
}

.trend-item-stats {
  font-size: 24rpx;
  color: var(--text-sub);
}

.trend-empty {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 20rpx 0;
}

.trend-detail {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--border-radius-sm);
  background: rgba(0, 0, 0, 0.02);
}

.trend-detail-scroll {
  max-height: 360rpx;
}

.trend-detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.trend-detail-sub {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 16rpx;
}

.trend-chart-canvas-wrap {
  width: 100%;
  background: rgba(255, 255, 255, 0.7);
  border-radius: var(--border-radius-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.trend-chart-canvas {
  width: 100%;
  display: block;
}

.trend-chart-empty {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 16rpx;
}

.trend-point-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trend-point-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed rgba(0, 0, 0, 0.08);
}

.trend-point-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.trend-point-value {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.trend-point-meta {
  font-size: 22rpx;
  color: var(--text-sub);
}

/* 系统状态 */
.status-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.status-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.status-item:first-child {
  padding-top: 0;
}

.status-label {
  font-size: 28rpx;
  color: var(--text-sub);
}

.status-value {
  font-size: 28rpx;
  font-weight: 500;
}

.status-success {
  color: var(--success-color);
}

.status-error {
  color: var(--danger-color);
}

.status-info {
  color: var(--primary-color);
}

/* 空状态 */
.empty-state {
  padding: 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
  filter: grayscale(100%);
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
}
