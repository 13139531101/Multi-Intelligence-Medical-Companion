/**index.wxss**/
.container {
  padding: 20rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* 区域标题 */
.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  display: block;
}

/* 区域头部通用样式 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-more {
  font-size: 24rpx;
  color: #007aff;
}

/* 区域容器 */
.section {
  margin-bottom: 40rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 快速操作区域 */
.quick-actions {
  display: flex;
  justify-content: center;
}

.action-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  width: 100%;
}

.action-item.consultation-item {
  background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%);
  border: 2rpx solid #e6f0ff;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  font-size: 40rpx;
}

.consultation-item .action-icon {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  width: 100rpx;
  height: 100rpx;
  font-size: 50rpx;
}

.action-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.consultation-item .action-title {
  font-size: 32rpx;
}

.action-desc {
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 15rpx;
}

.consultation-item .action-desc {
  font-size: 24rpx;
}

.action-count {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #ff4757;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 最近活动区域 */
.activity-list {
  display: flex;
  flex-direction: column;
}

.activity-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-icon {
  width: 60rpx;
  height: 60rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 30rpx;
}

.activity-content {
  flex: 1;
}

.activity-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.activity-time {
  font-size: 24rpx;
  color: #999;
}

/* 健康趋势 */
.trend-chart {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 12rpx;
}

.trend-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.trend-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.trend-desc {
  font-size: 24rpx;
  color: #666;
}

/* 系统状态 */
.status-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-item:last-child {
  border-bottom: none;
}

.status-label {
  font-size: 28rpx;
  color: #666;
}

.status-value {
  font-size: 28rpx;
  font-weight: 500;
}

.status-success {
  color: #52c41a;
}

.status-error {
  color: #ff4d4f;
}

.status-info {
  color: #1890ff;
}

/* 空状态 */
.empty-state {
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}
