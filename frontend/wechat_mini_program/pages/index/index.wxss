/**index.wxss**/
.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #aaa;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.usermotto {
  margin-top: 200px;
}

.button-container {
  margin-top: 20px;
}

.upload-btn {
  background-color: #007aff;
  color: white;
  border-radius: 8px;
  padding: 10px 20px;
}

.image-container {
  margin-top: 20px;
  position: relative;
  width: 200px;
  height: 200px;
  background-color: #f0f0f0;
  border-radius: 8px;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 122, 255, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.image-container:hover .image-overlay {
  opacity: 1;
}

.preview-text {
  color: white;
  font-size: 16px;
}

.api-status {
  margin-top: 10px;
  color: #888;
  font-size: 14px;
}

.entry-section {
  margin-top: 20px;
}

.entry-btn {
  background-color: #007aff;
  color: white;
}

/* 登录用户信息样式 */
.login-userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #007aff 0%, #0056cc 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar-text {
  color: white;
  font-size: 48rpx;
  font-weight: bold;
}

.username {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.logout-btn {
  background-color: #ff4757;
  color: white;
  border: none;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
  font-size: 24rpx;
}
