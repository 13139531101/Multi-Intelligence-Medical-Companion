/* medication.wxss */
.container {
  padding: 0 30rpx 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面标题 */
.page-header {
  padding: 40rpx 0 30rpx;
  text-align: center;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #666;
}

/* 快速操作 */
.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-item {
  flex: 1;
  background-color: #fff;
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 15rpx;
  display: block;
}

.action-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 通用区域样式 */
.today-section,
.records-section,
.reminders-section,
.stats-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-date {
  font-size: 26rpx;
  color: #666;
}

.section-more {
  font-size: 26rpx;
  color: #1890ff;
}

/* 今日用药 */
.medication-list {
  margin-bottom: 20rpx;
}

.medication-item {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  transition: transform 0.2s;
}

.medication-item:active {
  transform: scale(0.98);
}

.medication-time {
  font-size: 32rpx;
  font-weight: bold;
  color: #1890ff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.medication-info {
  flex: 1;
  margin-right: 15rpx;
}

.medication-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.medication-dose {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 3rpx;
}

.medication-type {
  font-size: 24rpx;
  color: #999;
}

.medication-status {
  margin-right: 15rpx;
  flex-shrink: 0;
}

.status-text {
  font-size: 24rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.status-text.pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

.status-text.taken {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-text.missed {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.medication-actions {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1;
}

.take-btn {
  background-color: #52c41a;
  color: #fff;
}

.skip-btn {
  background-color: #f0f0f0;
  color: #666;
}

/* 用药记录 */
.records-list {
  margin-bottom: 20rpx;
}

.record-item {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;
}

.record-item:active {
  transform: scale(0.98);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 15rpx;
  flex-wrap: wrap;
}

.record-dose,
.record-frequency,
.record-duration {
  font-size: 26rpx;
  color: #666;
}

.record-progress {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  margin-right: 15rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #52c41a;
  transition: width 0.3s;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.record-status {
  text-align: right;
}

.status-tag {
  font-size: 24rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.status-tag.active {
  background-color: #e6f7ff;
  color: #1890ff;
}

.status-tag.completed {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-tag.paused {
  background-color: #fff7e6;
  color: #fa8c16;
}

.status-tag.stopped {
  background-color: #fff2f0;
  color: #ff4d4f;
}

/* 用药提醒 */
.reminders-list {
  margin-bottom: 20rpx;
}

.reminder-item {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
}

.reminder-info {
  flex: 1;
}

.reminder-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.reminder-time {
  font-size: 26rpx;
  color: #1890ff;
  margin-bottom: 5rpx;
  display: block;
}

.reminder-frequency {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.reminder-switch {
  flex-shrink: 0;
}

/* 健康统计 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 10rpx;
  display: block;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
  display: block;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 25rpx;
  opacity: 0.3;
}

.empty-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 表单样式 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  background-color: #fff;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.dose-input {
  display: flex;
  gap: 15rpx;
}

.dose-number {
  flex: 2;
}

.dose-unit {
  flex: 1;
}

.time-inputs {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.time-picker {
  flex: 1;
  min-width: 150rpx;
  padding: 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  background-color: #fff;
  text-align: center;
}

.time-text {
  font-size: 28rpx;
  color: #333;
}

/* 按钮样式 */
.btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  line-height: 1;
}

.btn-cancel {
  background-color: #f0f0f0;
  color: #666;
}

.btn-primary {
  background-color: #1890ff;
  color: #fff;
}