/* medication.wxss */
.container {
  padding: 24rpx 24rpx 40rpx;
  background-color: #f6f7fb;
  min-height: 100vh;
  box-sizing: border-box;
}

.hero {
  padding: 40rpx;
  border-radius: 32rpx;
  background: var(--primary-gradient);
  box-shadow: var(--shadow-primary);
  margin: 32rpx 0;
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.hero-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
  display: block;
  font-weight: 500;
}

.hero-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.hero-action {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.hero-action:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
}

.hero-action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(79, 70, 229, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--primary-color);
}

.hero-action-text {
  flex: 1;
  min-width: 0;
}

.hero-action-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  display: block;
  margin-bottom: 4rpx;
}

.hero-action-desc {
  font-size: 22rpx;
  color: #6B7280;
  display: block;
}

/* 通用区域样式 */
.today-section,
.records-section,
.reminders-section,
.stats-section {
  margin-bottom: 32rpx;
}

.section-card {
  background-color: var(--card-bg);
  border-radius: var(--border-radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
}

.section-card:active {
  box-shadow: var(--shadow-md);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.section-date {
  font-size: 26rpx;
  color: #6b7280;
}

.section-more {
  font-size: 26rpx;
  color: #2b7cff;
}

/* 今日用药 */
.medication-scroll {
  max-height: 52vh;
}

.today-window-tabs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.today-window-tabs-left {
  flex: 1;
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background-color: #f6f7fb;
}

.today-window-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 10rpx 0;
  border-radius: 999rpx;
  color: #6b7280;
  font-weight: 600;
}

.today-window-tab.active {
  background-color: #fff;
  color: #111827;
  box-shadow: 0 8rpx 18rpx rgba(17, 24, 39, 0.06);
}

.today-window-action {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #2b7cff;
}

.medication-list {
  padding-bottom: 8rpx;
}

.medication-item {
  background-color: #f9fafb;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #eef2f7;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  transition: transform 0.2s;
}

.medication-item:active {
  transform: scale(0.98);
}

.medication-time {
  font-size: 34rpx;
  font-weight: 800;
  color: #2b7cff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.medication-info {
  flex: 1;
  margin-right: 15rpx;
  min-width: 0;
}

.medication-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.medication-dose {
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.medication-type {
  font-size: 24rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.medication-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.status-text {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
  white-space: nowrap;
}

.status-text.pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

.status-text.taken {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-text.missed {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.medication-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 0 18rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  border: none;
}

.take-btn {
  background-color: #52c41a;
  color: #fff;
}

.skip-btn {
  background-color: #f0f0f0;
  color: #4b5563;
}

/* 用药记录 - 垂直滑动窗口 */
.records-scroll-vertical {
  max-height: 600rpx;
  width: 100%;
}

.records-list {
  margin-bottom: 20rpx;
}

.record-item {
  background-color: #f9fafb;
  border-radius: 18rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  border: 1rpx solid #eef2f7;
  transition: transform 0.2s;
}

.record-item:active {
  transform: scale(0.98);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.record-date {
  font-size: 24rpx;
  color: #9ca3af;
}

.record-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 15rpx;
  flex-wrap: wrap;
}

.record-dose,
.record-frequency,
.record-duration {
  font-size: 26rpx;
  color: #4b5563;
}

.record-progress {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background-color: #eef2f7;
  border-radius: 4rpx;
  margin-right: 15rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #52c41a;
  transition: width 0.3s;
}

.progress-text {
  font-size: 24rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.record-status {
  text-align: right;
}

.record-status-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

.status-tag {
  font-size: 24rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.record-delete-btn {
    margin: 0;
    padding: 0 16rpx;
    height: 48rpx;
    line-height: 48rpx;
    font-size: 24rpx;
    background-color: #fee2e2;
    color: #ef4444;
    border-radius: 8rpx;
}

.record-delete-btn {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background-color: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid rgba(255, 77, 79, 0.25);
}

.status-tag.active {
  background-color: #e6f7ff;
  color: #2b7cff;
}

.status-tag.completed {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-tag.paused {
  background-color: #fff7e6;
  color: #fa8c16;
}

.status-tag.stopped {
  background-color: #fff2f0;
  color: #ff4d4f;
}

/* 用药提醒 */
.reminders-list {
  margin-bottom: 20rpx;
}

.reminder-item {
  background-color: #f9fafb;
  border-radius: 18rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  border: 1rpx solid #eef2f7;
  display: flex;
  align-items: center;
}

.reminder-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.reminder-info {
  flex: 1;
  min-width: 0;
}

.reminder-medication {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-time {
  font-size: 26rpx;
  font-weight: 700;
  color: #2b7cff;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(43, 124, 255, 0.1);
  flex-shrink: 0;
}

.reminder-frequency {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
  display: block;
}

.reminder-switch {
  flex-shrink: 0;
}

/* 健康统计 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat-item {
  background-color: #f9fafb;
  border-radius: 18rpx;
  padding: 28rpx 20rpx;
  text-align: left;
  border: 1rpx solid #eef2f7;
}

.stat-number {
  font-size: 36rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 10rpx;
  display: block;
}

.stat-label {
  font-size: 26rpx;
  color: #6b7280;
  display: block;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 25rpx;
  opacity: 0.3;
}

.empty-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 表单样式 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  background-color: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
  line-height: 1.4;
}

.dose-input {
  display: flex;
  gap: 15rpx;
}

.dose-number {
  flex: 2;
}

.dose-unit {
  flex: 1;
}

.date-range {
  display: flex;
  gap: 15rpx;
}

.date-picker {
  flex: 1;
  min-width: 150rpx;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  background-color: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.time-inputs {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.time-picker {
  flex: 1;
  min-width: 150rpx;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  background-color: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.time-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

/* 按钮样式 */
.btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  line-height: 1;
}

.btn-cancel {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  line-height: 1;
  background-color: #f0f0f0;
  color: #666;
}

.btn-submit {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  line-height: 1;
  background-color: #2b7cff;
  color: #fff;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.scan-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(43, 124, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.form-tip {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 12rpx;
}
