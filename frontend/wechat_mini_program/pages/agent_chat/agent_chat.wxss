/* 聊天容器 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-color);
  position: relative;
}

/* 聊天历史区域 */
.chat-history {
  padding: 32rpx;
  background-color: var(--bg-color);
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(250rpx + env(safe-area-inset-bottom));
}

.jump-to-bottom {
  position: absolute;
  right: 32rpx;
  bottom: calc(280rpx + env(safe-area-inset-bottom));
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.8);
  color: #fff;
  font-size: 26rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(8px);
}

/* 消息容器 */
.message-bubble-container {
  display: flex;
  align-items: flex-end; /* Align to bottom for better chat feel */
  margin-bottom: 48rpx;
  padding: 0;
}

.message-bubble-container.user {
  flex-direction: row-reverse;
}

.message-bubble-container.assistant {
  flex-direction: row;
}

/* 头像样式 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx; /* Squircle */
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 24rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.user-avatar {
  background: var(--primary-gradient);
}

.ai-avatar {
  background: linear-gradient(135deg, var(--secondary-color) 0%, #059669 100%);
}

.avatar-text {
  color: white;
  font-size: 28rpx;
  font-weight: 700;
}

/* 消息气泡 */
.message-bubble {
  max-width: 520rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  word-wrap: break-word;
  position: relative;
  box-shadow: var(--shadow-sm);
  font-size: 30rpx;
  line-height: 1.6;
}

.message-bubble-container.user .message-bubble {
  background: var(--primary-gradient);
  color: white;
  border-bottom-right-radius: 4rpx;
  border-top-right-radius: 32rpx;
  box-shadow: var(--shadow-primary);
}

.message-bubble-container.assistant .message-bubble {
  background-color: var(--card-bg);
  color: var(--text-main);
  border: none;
  border-bottom-left-radius: 4rpx;
  border-top-left-radius: 32rpx;
}

/* 消息内容 */
.message-content {
  font-size: 32rpx;
  line-height: 1.6;
  word-break: break-word;
}

.thinking-block {
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.03);
  margin-bottom: 18rpx;
}

.thinking-toggle {
  font-size: 24rpx;
  color: var(--text-sub);
}

.thinking-content {
  margin-top: 12rpx;
}

.thinking-rich {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-sub);
  word-break: break-word;
}

.streaming-status {
  padding: 8rpx 0 14rpx;
}

.streaming-text {
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: 500;
}

.streaming-footer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.streaming-footer .typing-indicator {
  margin-bottom: 0;
}

.streaming-footer .dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
}

/* 图片消息 */
.message-image {
  max-width: 100%;
  border-radius: 16rpx;
  margin-top: 16rpx;
  display: block;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 文件消息 */
.message-file {
  display: flex;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.05);
  padding: 20rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
}

.message-bubble-container.user .message-file {
  background-color: rgba(255, 255, 255, 0.2);
}

.file-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.file-info {
  flex: 1;
  overflow: hidden;
}

.file-name {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.file-type {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

/* AI回答滚动窗口 */
.message-content-collapsed {
  max-height: 260rpx;
  overflow: hidden;
  mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
}

.expand-toggle {
  margin-top: 16rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 20rpx;
  background: #fff;
  color: var(--primary-color);
  box-shadow: var(--shadow-sm);
}

/* 时间戳 */
.message-time {
  font-size: 22rpx;
  opacity: 0.6;
  margin-top: 12rpx;
  text-align: right;
  font-weight: 500;
}

.message-bubble-container.assistant .message-time {
  color: var(--text-sub);
}

.message-bubble-container.user .message-time {
  color: rgba(255, 255, 255, 0.9);
}

/* 重复计数 */
.dup-count {
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 10rpx;
  padding: 6rpx 16rpx;
  background-color: rgba(0, 0, 0, 0.15);
  border-radius: 20rpx;
  display: inline-block;
  font-weight: 600;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
  padding: 0 10rpx;
}

.loading-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #34c759 0%, #30a14e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.loading-bubble {
  background-color: white;
  padding: 24rpx 30rpx;
  border-radius: 32rpx;
  border-bottom-left-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: var(--shadow-sm);
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  margin-right: 10rpx;
  animation: typing 1.4s infinite ease-in-out;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

.dot:nth-child(3) {
  margin-right: 0;
}

@keyframes typing {
  0%,
  80%,
  100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: 500;
}

/* 输入区域 */
.chat-input-area {
  background-color: white;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-container {
  background-color: #f5f7fa;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  transition:
    border-color 0.3s,
    background-color 0.3s;
}

.input-container:active {
  background-color: white;
  border-color: var(--primary-color);
}

.chat-input {
  width: 100%;
  min-height: 80rpx;
  max-height: 200rpx;
  font-size: 32rpx;
  line-height: 1.5;
  background-color: transparent;
  border: none;
  outline: none;
  resize: none;
  color: var(--text-main);
}

.input-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 16rpx;
}

.char-count {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-right: 20rpx;
}

.attachment-button,
.voice-button {
  margin: 0 12rpx 0 0 !important;
  padding: 8rpx 20rpx !important;
  min-height: 56rpx !important;
  line-height: 1.4 !important;
  border-radius: 24rpx !important;
  border: 1rpx solid rgba(0, 0, 0, 0.08) !important;
  background: #fff !important;
  color: var(--text-main) !important;
  font-size: 28rpx !important;
  width: auto !important;
}

.voice-button.recording {
  background: #fee2e2 !important;
  color: #b91c1c !important;
  border-color: #fecaca !important;
}

.send-button {
  margin: 0 !important;
  padding: 10rpx 30rpx !important;
  font-size: 28rpx !important;
  border-radius: 30rpx !important;
  background: var(--primary-color) !important;
  color: white !important;
  font-weight: 500 !important;
  min-height: 60rpx !important;
  line-height: 1.5 !important;
  width: auto !important;
}

.send-button.disabled {
  background: #e0e0e0 !important;
  color: #999 !important;
}

.send-button.active {
  background: var(--primary-gradient) !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
}

.pending-attachments {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pending-attachment-item {
  display: flex;
  align-items: center;
  max-width: 100%;
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  background: #f3f4f6;
}

.pending-image {
  width: 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  margin-right: 10rpx;
}

.pending-file-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.pending-name {
  max-width: 260rpx;
  font-size: 22rpx;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pending-remove {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  padding: 4rpx 8rpx;
}

/* === 阶段35: v2 模式切换栏样式 === */
.v2-mode-bar {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background-color: rgba(0, 0, 0, 0.02);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}
.v2-mode-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}
.v2-mode-label {
  font-size: 22rpx;
  color: #666;
}
.v2-mode-pill {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background-color: #f0f0f0;
  color: #333;
  font-size: 24rpx;
  border: 1rpx solid transparent;
}
.v2-mode-pill.active {
  background-color: #1890ff;
  color: #fff;
  border-color: #1890ff;
}
.v2-mode-info {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
}

/* 阶段35: agent 路由指示器 */
.agent-routing-indicator {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  margin: 8rpx 24rpx;
  background-color: rgba(24, 144, 255, 0.08);
  border-left: 4rpx solid #1890ff;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #1890ff;
}
.agent-routing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #1890ff;
  animation: pulse 1.5s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1.0; }
}
