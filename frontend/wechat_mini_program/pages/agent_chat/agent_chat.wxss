/* 聊天容器 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-color);
  position: relative;
}

/* 聊天历史区域 */
.chat-history {
  padding: 30rpx 20rpx;
  background-color: var(--bg-color);
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(250rpx + env(safe-area-inset-bottom));
}

.jump-to-bottom {
  position: absolute;
  right: 30rpx;
  bottom: calc(260rpx + env(safe-area-inset-bottom));
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.72);
  color: #fff;
  font-size: 26rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(10px);
}

/* 消息容器 */
.message-bubble-container {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
  padding: 0 10rpx;
}

.message-bubble-container.user {
  flex-direction: row-reverse;
}

.message-bubble-container.assistant {
  flex-direction: row;
}

/* 头像样式 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.user-avatar {
  background: var(--primary-gradient);
}

.ai-avatar {
  background: linear-gradient(135deg, #34c759 0%, #30a14e 100%);
}

.avatar-text {
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

/* 消息气泡 */
.message-bubble {
  max-width: 520rpx;
  padding: 24rpx 30rpx;
  border-radius: 32rpx;
  word-wrap: break-word;
  position: relative;
  box-shadow: var(--shadow-sm);
}

.message-bubble-container.user .message-bubble {
  background: var(--primary-gradient);
  color: white;
  border-bottom-right-radius: 8rpx;
  border-top-right-radius: 32rpx;
}

.message-bubble-container.assistant .message-bubble {
  background-color: white;
  color: var(--text-main);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-bottom-left-radius: 8rpx;
  border-top-left-radius: 32rpx;
}

/* 消息内容 */
.message-content {
  font-size: 32rpx;
  line-height: 1.6;
  word-break: break-word;
}

/* 图片消息 */
.message-image {
  max-width: 100%;
  border-radius: 16rpx;
  margin-top: 16rpx;
  display: block;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 文件消息 */
.message-file {
  display: flex;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.05);
  padding: 20rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
}

.message-bubble-container.user .message-file {
  background-color: rgba(255, 255, 255, 0.2);
}

.file-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.file-info {
  flex: 1;
  overflow: hidden;
}

.file-name {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.file-type {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

/* AI回答滚动窗口 */
.message-content-collapsed {
  max-height: 600rpx;
  overflow: hidden;
  mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
}

.expand-toggle {
  margin-top: 16rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 20rpx;
  background: #fff;
  color: var(--primary-color);
  box-shadow: var(--shadow-sm);
}

/* 时间戳 */
.message-time {
  font-size: 22rpx;
  opacity: 0.6;
  margin-top: 12rpx;
  text-align: right;
  font-weight: 500;
}

.message-bubble-container.assistant .message-time {
  color: var(--text-sub);
}

.message-bubble-container.user .message-time {
  color: rgba(255, 255, 255, 0.9);
}

/* 重复计数 */
.dup-count {
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 10rpx;
  padding: 6rpx 16rpx;
  background-color: rgba(0, 0, 0, 0.15);
  border-radius: 20rpx;
  display: inline-block;
  font-weight: 600;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
  padding: 0 10rpx;
}

.loading-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #34c759 0%, #30a14e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.loading-bubble {
  background-color: white;
  padding: 24rpx 30rpx;
  border-radius: 32rpx;
  border-bottom-left-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: var(--shadow-sm);
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  margin-right: 10rpx;
  animation: typing 1.4s infinite ease-in-out;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

.dot:nth-child(3) {
  margin-right: 0;
}

@keyframes typing {
  0%,
  80%,
  100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: 500;
}

/* 输入区域 */
.chat-input-area {
  background-color: white;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-container {
  background-color: #f5f7fa;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: border-color 0.3s, background-color 0.3s;
}

.input-container:active {
  background-color: white;
  border-color: var(--primary-color);
}

.chat-input {
  width: 100%;
  min-height: 80rpx;
  max-height: 200rpx;
  font-size: 32rpx;
  line-height: 1.5;
  background-color: transparent;
  border: none;
  outline: none;
  resize: none;
  color: var(--text-main);
}

.input-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 16rpx;
}

.char-count {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-right: 20rpx;
}

.send-button {
  margin: 0 !important;
  padding: 10rpx 30rpx !important;
  font-size: 28rpx !important;
  border-radius: 30rpx !important;
  background: var(--primary-color) !important;
  color: white !important;
  font-weight: 500 !important;
  min-height: 60rpx !important;
  line-height: 1.5 !important;
  width: auto !important;
}

.send-button.disabled {
  background: #e0e0e0 !important;
  color: #999 !important;
}

.send-button.active {
  background: var(--primary-gradient) !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
}
