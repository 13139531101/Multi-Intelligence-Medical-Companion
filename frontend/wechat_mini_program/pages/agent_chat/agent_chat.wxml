<!--pages/agent_chat/agent_chat.wxml-->
  <view class="chat-container">
  <!-- 聊天历史区域 -->
  <scroll-view
    scroll-y="true"
    class="chat-history"
    id="messageList"
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation="true"
    lower-threshold="80"
    bindscroll="handleScroll"
    bindscrolltolower="handleScrollToLower"
  >
    <view wx:for="{{messages}}" wx:for-item="item" wx:for-index="idx" wx:key="id" id="{{'msg-' + item.id}}" class="message-bubble-container {{item.role}}">
      <!-- 用户头像 -->
      <view wx:if="{{item.role === 'user'}}" class="avatar user-avatar">
        <text class="avatar-text">我</text>
      </view>
      
      <!-- AI头像 -->
      <view wx:if="{{item.role === 'assistant'}}" class="avatar ai-avatar">
        <text class="avatar-text">AI</text>
      </view>
      
      <!-- 消息气泡 -->
      <view class="message-bubble">
        <!-- 消息内容 -->
        <view class="message-content-scroll-wrapper {{(item.role === 'assistant' && item.isLong && item.collapsed) ? 'message-content-collapsed' : ''}}">
          <view wx:if="{{item.role === 'assistant' && item.isStreaming && !item.rawText}}" class="streaming-status">
            <view class="typing-indicator">
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
            <text class="streaming-text">AI思考中...</text>
          </view>
          <view wx:if="{{item.role === 'assistant' && item.thinkingRaw && !item.isStreaming}}" class="thinking-block">
            <view class="thinking-toggle" bindtap="toggleThinking" data-index="{{idx}}">
              <text>{{item.showThinking ? '收起思考过程' : '展开思考过程'}}</text>
            </view>
            <view wx:if="{{item.showThinking}}" class="thinking-content">
              <rich-text class="thinking-rich" nodes="{{item.thinkingHtml}}"></rich-text>
            </view>
          </view>
          <block wx:for="{{item.contentParts}}" wx:key="index" wx:for-item="part">
            <rich-text wx:if="{{part.type === 'text'}}" class="message-content" nodes="{{part.content}}"></rich-text>
            <image wx:if="{{part.type === 'image'}}" src="{{part.url}}" mode="widthFix" class="message-image" bindtap="previewImage" data-src="{{part.url}}"></image>
            <view wx:if="{{part.type === 'file'}}" class="message-file" bindtap="openFile" data-url="{{part.url}}" data-type="{{part.mimeType}}">
              <view class="file-icon">📄</view>
              <view class="file-info">
                <view class="file-name">{{part.name}}</view>
                <view class="file-type">点击预览</view>
              </view>
            </view>
          </block>
        </view>

        <button
          wx:if="{{item.role === 'assistant' && item.isLong && !item.isStreaming}}"
          class="expand-toggle"
          bindtap="toggleExpand"
          data-index="{{idx}}"
        >
          {{item.collapsed ? '展开全文' : '收起'}}
        </button>
        
        <!-- 时间戳 -->
        <view class="message-time">{{item.timeString}}</view>
        
        <!-- 重复计数 -->
        <view wx:if="{{item.dupCount > 1}}" class="dup-count">
          <text>重复 {{item.dupCount}} 次</text>
        </view>
      </view>
    </view>
    
    <!-- 加载状态 -->
    <view wx:if="{{isSending && !agentUrl}}" class="loading-container">
      <view class="loading-avatar">
        <text class="avatar-text">AI</text>
      </view>
      <view class="loading-bubble">
        <view class="typing-indicator">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
        <text class="loading-text">AI正在思考中...</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{showJumpToBottom}}" class="jump-to-bottom" bindtap="jumpToBottom">
    <text>回到底部</text>
    <text wx:if="{{unreadCount > 0}}">({{unreadCount}})</text>
  </view>
  
  <!-- 输入区域 -->
  <view class="chat-input-area">
    <view class="input-container">
      <textarea 
        class="chat-input" 
        placeholder="有什么健康问题问我..." 
        value="{{inputText}}" 
        bindinput="handleInput"
        auto-height
        maxlength="500"
        show-confirm-bar="{{false}}"
        cursor-spacing="10"
      ></textarea>
      <view class="input-actions">
        <text class="char-count">{{inputText.length}}/500</text>
        <button 
        class="send-button {{(inputText.trim() && !isSending) ? 'active' : 'disabled'}}" 
        bindtap="handleSend"
        >
        {{isSending ? '发送中' : '发送'}}
        </button>
        <!-- 无disabled的发送按钮 -->

      </view>
    </view>
  </view>
</view>
