<view class="container">
  <view class="header">
    <view class="meta-row">
      <view class="type">{{record.record_type_label}}</view>
      <view class="date">{{record.formatted_date}}</view>
    </view>
    <view class="meta-row" wx:if="{{record.hospital || record.doctor}}">
      <view class="meta-item" wx:if="{{record.hospital}}">医院：{{record.hospital}}</view>
      <view class="meta-item" wx:if="{{record.doctor}}">医生：{{record.doctor}}</view>
    </view>
  </view>

  <view class="section" wx:if="{{fileUrls.length}}">
    <view class="section-title">原图</view>
    <view class="image-grid">
      <image class="thumb" wx:for="{{thumbUrls}}" wx:key="index" wx:for-index="index" src="{{item}}" mode="aspectFill" catchtap="previewImage" binderror="onThumbError" data-index="{{index}}" data-urls="{{previewUrls}}" data-current="{{previewUrls[index]}}"></image>
    </view>
  </view>

  <view class="section" wx:if="{{displayKvs.length || structuredSummary}}">
    <view class="section-title">一眼看懂</view>
    <view class="kv-list" wx:if="{{displayKvs.length}}">
      <view class="kv-row" wx:for="{{displayKvs}}" wx:key="label">
        <view class="kv-name">{{item.label}}</view>
        <view class="kv-value">{{item.value}}</view>
      </view>
    </view>
    <view class="section-content" wx:elif="{{structuredSummary}}">{{structuredSummary}}</view>
  </view>

  <view class="section" wx:if="{{testItems.length}}">
    <view class="section-title">全部指标（{{testItems.length}}）</view>
    <scroll-view class="tests-scroll" scroll-y style="height: {{testsScrollHeight}}px;">
      <view class="kv-list">
        <view class="kv-row" wx:for="{{visibleTestItems}}" wx:key="name">
          <view class="kv-name">{{item.name}}</view>
          <view class="kv-value test-kv-value">{{item.valueText}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="section" wx:if="{{ocrPreview}}">
    <view class="section-title">OCR全文</view>
    <view class="section-content">{{ocrExpanded ? ocrText : ocrPreview}}</view>
    <view class="section-actions" wx:if="{{ocrHasMore}}">
      <view class="toggle-btn" bindtap="toggleOcr">{{ocrExpanded ? '收起' : '展开全文'}}</view>
    </view>
  </view>

  <view class="section" wx:if="{{record.display_description && !structuredSummary && !ocrPreview}}">
    <view class="section-title">内容</view>
    <view class="section-content">{{record.display_description}}</view>
  </view>

  <view class="empty" wx:if="{{!isLoading && !record}}">
    暂无详情内容
  </view>
</view>
