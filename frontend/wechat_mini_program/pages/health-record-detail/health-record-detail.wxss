.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.type {
  background-color: #e6f7ff;
  color: #1890ff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.date {
  font-size: 24rpx;
  color: #999;
}

.meta-item {
  font-size: 26rpx;
  color: #666;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  background-color: #f0f0f0;
  color: #666;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
}

.section-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  white-space: pre-wrap;
}

.files {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.file-item {
  background-color: #f5f7ff;
  color: #3c5bff;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.kv-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.kv-name {
  font-size: 26rpx;
  color: #333;
  max-width: 62%;
}

.kv-value {
  font-size: 26rpx;
  color: #111;
  font-weight: 500;
  max-width: 38%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.test-kv-value {
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  word-break: break-all;
}

.tests-scroll {
  margin-top: 6rpx;
}

.section-subtitle {
  margin-top: 18rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.section-actions {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
}

.toggle-btn {
  font-size: 26rpx;
  color: #1890ff;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 60rpx 0;
}
