.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.type {
  background-color: #e6f7ff;
  color: #1890ff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.date {
  font-size: 24rpx;
  color: #999;
}

.meta-item {
  font-size: 26rpx;
  color: #666;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  background-color: #f0f0f0;
  color: #666;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
}

.section-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  white-space: pre-wrap;
}

.files {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.file-item {
  background-color: #f5f7ff;
  color: #3c5bff;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 60rpx 0;
}
