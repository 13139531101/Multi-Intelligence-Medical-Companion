/* pages/agents_status/agents_status.wxss */
.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.subtitle {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}
.meta {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 16rpx;
}
.badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  color: #666;
}
.badge.ok { background: #e6f7e6; color: #389e0d; }
.badge.err { background: #fff1f0; color: #cf1322; }

.refresh-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.btn-refresh, .btn-anp-test {
  flex: 1;
  background: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  padding: 16rpx 0;
}
.btn-anp-test { background: #722ed1; }
.btn-refresh[disabled] { background: #d9d9d9; }

.error-bar {
  background: #fff1f0;
  color: #cf1322;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.agent-list, .anp-list, .model-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.agent-card {
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
  border-left: 6rpx solid #1890ff;
}
.agent-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.agent-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.agent-loaded {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}
.agent-loaded.yes { background: #e6f7e6; color: #389e0d; }
.agent-loaded.no { background: #f5f5f5; color: #999; }
.agent-desc {
  font-size: 24rpx;
  color: #555;
  margin-top: 8rpx;
}
.agent-meta {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.anp-card {
  padding: 16rpx 20rpx;
  background: #f9f0ff;
  border-radius: 12rpx;
  border-left: 6rpx solid #722ed1;
}
.anp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.anp-desc {
  font-size: 24rpx;
  color: #555;
  margin-top: 6rpx;
}
.anp-did {
  margin-top: 12rpx;
  padding: 8rpx 12rpx;
  background: #fff;
  border-radius: 8rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.did-text {
  font-size: 22rpx;
  font-family: monospace;
  color: #555;
}
.did-copy { font-size: 24rpx; }

.model-card {
  padding: 12rpx 20rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #1890ff;
}

.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.detail-card {
  width: 90%;
  max-width: 720rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: auto;
  padding: 24rpx;
}
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}
.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.detail-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx 16rpx;
}
.detail-row {
  display: flex;
  margin-bottom: 12rpx;
}
.detail-row .label {
  font-size: 24rpx;
  color: #888;
  min-width: 160rpx;
}
.detail-row .value {
  font-size: 24rpx;
  color: #1a1a1a;
  flex: 1;
  word-break: break-all;
}
.tool-names { font-size: 20rpx; color: #555; }
.detail-error { color: #cf1322; }

.footer {
  text-align: center;
  padding: 32rpx 0;
  font-size: 22rpx;
  color: #999;
}