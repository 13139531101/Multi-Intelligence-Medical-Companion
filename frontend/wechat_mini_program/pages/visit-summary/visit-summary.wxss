/* pages/visit-summary/visit-summary.wxss */
.container {
  padding: 32rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

.page-header {
  padding: 40rpx 0;
}

.page-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 16rpx;
  letter-spacing: -1rpx;
}

.page-desc {
  font-size: 30rpx;
  color: var(--text-sub);
  line-height: 1.5;
}

.upload-section {
  margin: 32rpx 0 64rpx;
}

.upload-card {
  background: var(--card-bg);
  border-radius: var(--border-radius-lg);
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-md);
  border: 2rpx dashed #E5E7EB;
  transition: all 0.3s ease;
}

.upload-card:active {
  background: #F9FAFB;
  transform: scale(0.98);
  border-color: var(--primary-color);
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  color: var(--primary-color);
  background: rgba(79, 70, 229, 0.1);
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.upload-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.upload-sub {
  font-size: 26rpx;
  color: var(--text-sub);
}

.summary-list {
  margin-top: 40rpx;
}

.list-header {
  margin-bottom: 24rpx;
  padding: 0 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}

.summary-item {
  background: var(--card-bg);
  border-radius: var(--border-radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
}

.summary-item:active {
  box-shadow: var(--shadow-md);
  transform: scale(0.99);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.hospital-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  flex: 1;
  margin-right: 16rpx;
}

.hospital-name.collapsed {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hospital-name.expanded {
  white-space: normal;
}

.visit-date {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1;
  background: #f2f2f2;
  color: #666;
}

.status-badge.processing {
  background: rgba(255, 149, 0, 0.12);
  color: #ff9500;
}

.status-badge.failed {
  background: rgba(255, 59, 48, 0.12);
  color: #ff3b30;
}

.item-body {
  margin-bottom: 20rpx;
}

.diagnosis-row {
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
}

.summary-row {
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
}

.label {
  font-size: 28rpx;
  color: #666;
  width: 100rpx;
  flex-shrink: 0;
}

.value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.diagnosis-value.collapsed {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diagnosis-value.expanded {
  white-space: normal;
}

.summary-text {
  font-size: 26rpx;
  color: #444;
  flex: 1;
  line-height: 1.5;
  word-break: break-all;
}

.summary-text.collapsed {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.summary-text.expanded {
  display: block;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-left: 100rpx;
}

.tag {
  font-size: 24rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.bullets {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 2rpx;
}

.bullet {
  font-size: 26rpx;
  color: #444;
  line-height: 1.5;
  word-break: break-all;
}

.item-footer {
  display: flex;
  justify-content: flex-end;
}

.view-more {
  font-size: 26rpx;
  color: #999;
  margin-left: 24rpx;
}

.delete-btn {
  font-size: 26rpx;
  color: #ff3b30;
}

.retry-btn {
  font-size: 26rpx;
  color: #007aff;
  margin-right: 24rpx;
}

.images-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-left: 100rpx;
  margin-top: 10rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state text {
  font-size: 28rpx;
  color: #999;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}
