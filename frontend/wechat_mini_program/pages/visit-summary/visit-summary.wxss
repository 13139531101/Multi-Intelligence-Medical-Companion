/* visit-summary.wxss */
.container {
  padding: 0 30rpx 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面标题 */
.page-header {
  padding: 40rpx 0 30rpx;
  text-align: center;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #666;
}

/* 快速操作 */
.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-item {
  flex: 1;
  background-color: #fff;
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 15rpx;
  display: block;
}

.action-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 通用区域样式 */
.recent-section,
.category-section,
.analysis-section,
.suggestions-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #1890ff;
}

/* 摘要列表 */
.summary-list {
  margin-bottom: 20rpx;
}

.summary-item {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;
}

.summary-item:active {
  transform: scale(0.98);
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.summary-type {
  background-color: #e6f7ff;
  color: #1890ff;
  padding: 6rpx 12rpx;
  border-radius: 15rpx;
  font-size: 22rpx;
}

.summary-date {
  font-size: 24rpx;
  color: #999;
}

.summary-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.summary-hospital {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.summary-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.summary-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  background-color: #f0f9ff;
  color: #1890ff;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.status-text {
  font-size: 24rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.status-text.active {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-text.completed {
  background-color: #f0f0f0;
  color: #666;
}

.status-text.pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

/* 分类 */
.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
}

.category-item {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.category-count {
  font-size: 24rpx;
  color: #666;
}

/* 智能分析 */
.analysis-card {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.analysis-period {
  font-size: 24rpx;
  color: #666;
}

.analysis-content {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
}

.trend-item {
  text-align: center;
}

.trend-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.trend-chart {
  height: 120rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  position: relative;
  margin-bottom: 8rpx;
}

.chart-bar {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  background-color: #1890ff;
  border-radius: 8rpx 8rpx 0 0;
}

.chart-bar.health {
  background-color: #52c41a;
}

.chart-bar.medication {
  background-color: #fa8c16;
}

.trend-value {
  font-size: 24rpx;
  color: #666;
}

.analysis-summary {
  margin-top: 15rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 建议列表 */
.suggestions-list {
  margin-bottom: 20rpx;
}

.suggestion-item {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: flex-start;
}

.suggestion-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.suggestion-content {
  flex: 1;
}

.suggestion-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.suggestion-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.suggestion-priority {
  margin-left: 15rpx;
  flex-shrink: 0;
}

.priority-text {
  font-size: 24rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.priority-text.high {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.priority-text.medium {
  background-color: #fff7e6;
  color: #fa8c16;
}

.priority-text.low {
  background-color: #f6ffed;
  color: #52c41a;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 25rpx;
  opacity: 0.3;
}

.empty-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 650rpx;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-content.large {
  max-width: 750rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 表单样式 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  background-color: #fff;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

/* 选择项 */
.create-options {
  display: flex;
  flex-direction: column;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.option-item:last-child {
  border-bottom: none;
}

.option-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.option-info {
  flex: 1;
}

.option-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.option-desc {
  font-size: 26rpx;
  color: #666;
}

.option-arrow {
  font-size: 28rpx;
  color: #ccc;
  flex-shrink: 0;
}

/* 上传区域 */
.upload-area {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 15rpx rgba(0, 0, 0, 0.1);
}

.upload-placeholder {
  text-align: center;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.upload-desc {
  font-size: 24rpx;
  color: #999;
}

.uploaded-images {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.image-item {
  position: relative;
}

.uploaded-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 10rpx;
}

.image-delete {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  background-color: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  text-align: center;
  line-height: 40rpx;
}

.add-image {
  width: 180rpx;
  height: 180rpx;
  border: 1rpx dashed #d9d9d9;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 40rpx;
  color: #999;
}