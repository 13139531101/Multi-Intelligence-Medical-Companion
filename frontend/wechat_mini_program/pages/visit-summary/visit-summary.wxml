<!--pages/visit-summary/visit-summary.wxml-->
<view class="container">
  <view class="page-header">
    <view class="page-title">就诊摘要</view>
    <view class="page-desc">提取诊断/用药/检查/医嘱，方便回顾与复诊</view>
  </view>

  <!-- 上传区域 -->
  <view class="upload-section">
    <view class="upload-card" bindtap="chooseImage">
      <view class="upload-icon">📸</view>
      <view class="upload-text">拍照/上传就诊材料(生成摘要)</view>
      <view class="upload-sub">支持处方单、检查报告、病历本等</view>
    </view>
  </view>

  <!-- 摘要列表 -->
  <view class="summary-list">
    <view class="list-header">
      <text class="list-title">历史摘要</text>
    </view>

    <view class="loading" wx:if="{{isLoading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <view class="summary-items" wx:if="{{summaries.length > 0}}">
      <view class="summary-item" wx:for="{{summaries}}" wx:key="id">
        <view class="item-header">
          <text class="hospital-name collapsed">{{item.hospitalDisplay}}</text>
          <view class="item-meta">
            <text class="visit-date">{{item.visitDateDisplay}}</text>
            <text class="status-badge {{item.statusClass}}" wx:if="{{item.statusDisplay}}">{{item.statusDisplay}}</text>
          </view>
        </view>
        <view class="item-body">
          <view class="summary-row" wx:if="{{item.departmentDisplay || item.doctorDisplay}}">
            <text class="label">就诊：</text>
            <view class="value">{{item.departmentDisplay}}{{item.departmentDisplay && item.doctorDisplay ? ' / ' : ''}}{{item.doctorDisplay}}</view>
          </view>
          <view class="summary-row" wx:if="{{item.diagnosisDisplay && item.diagnosisDisplay !== '未识别'}}">
            <text class="label">诊断：</text>
            <view class="value">{{item.diagnosisDisplay}}</view>
          </view>

          <view class="summary-row" wx:if="{{item.medTags && item.medTags.length}}">
            <text class="label">用药：</text>
            <view class="tags-row">
              <view class="tag" wx:for="{{item.medTags}}" wx:key="*this">{{item}}</view>
            </view>
          </view>

          <view class="summary-row" wx:if="{{item.followUpDisplay}}">
            <text class="label">随访：</text>
            <view class="value">{{item.followUpDisplay}}</view>
          </view>

          <view class="summary-row" wx:if="{{item.keyPoints && item.keyPoints.length}}">
            <text class="label">要点：</text>
            <view class="bullets">
              <view class="bullet" wx:for="{{item.keyPoints}}" wx:key="*this">• {{item}}</view>
            </view>
          </view>

          <view class="summary-row" wx:if="{{item.summaryText}}">
            <text class="label">原文：</text>
            <view class="summary-text {{item.expanded ? 'expanded' : 'collapsed'}}">{{item.expanded ? item.summaryText : item.summaryPreview}}</view>
          </view>
          <view class="summary-row" wx:elif="{{item.statusClass === 'processing'}}">
            <text class="label">原文：</text>
            <view class="summary-text collapsed">后台整理中，请稍候...</view>
          </view>
          <view class="summary-row" wx:elif="{{item.statusClass === 'failed'}}">
            <text class="label">原因：</text>
            <view class="summary-text collapsed">{{item.errorMessageDisplay || '整理失败，请重试上传'}}</view>
          </view>
          <view class="images-row" wx:if="{{item.fileUrls && item.fileUrls.length}}">
            <image class="thumb" wx:for="{{item.fileUrls}}" wx:key="*this" wx:for-item="url" src="{{url}}" mode="aspectFill" catchtap="previewImage" data-urls="{{item.fileUrls}}" data-current="{{url}}"></image>
          </view>
        </view>
        <view class="item-footer">
          <text class="retry-btn" wx:if="{{item.statusClass === 'failed'}}" catchtap="chooseImage">重试上传</text>
          <text class="delete-btn" catchtap="deleteSummary" data-id="{{item.id}}">删除</text>
          <text class="view-more" wx:if="{{item.canExpand}}" catchtap="toggleExpand" data-id="{{item.id}}">{{item.expanded ? '收起' : '展开'}}</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:elif="{{!isLoading}}">
      <view class="empty-icon">📝</view>
      <text>暂无就诊摘要记录</text>
    </view>
  </view>
</view>

<!-- AI助手小窗 -->
<floating-ai-btn agent-type="summary" />
