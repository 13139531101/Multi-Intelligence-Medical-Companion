<!--pages/visit-summary/visit-summary.wxml-->
<view class="container">
  <view class="page-header">
    <view class="page-title">就诊摘要</view>
    <view class="page-desc">智能整理您的每次就诊记录</view>
  </view>

  <!-- 上传区域 -->
  <view class="upload-section">
    <view class="upload-card" bindtap="chooseImage">
      <view class="upload-icon">📸</view>
      <view class="upload-text">拍照/上传病历</view>
      <view class="upload-sub">支持处方单、检查报告、病历本等</view>
    </view>
  </view>

  <!-- 摘要列表 -->
  <view class="summary-list">
    <view class="list-header">
      <text class="list-title">历史摘要</text>
    </view>

    <view class="loading" wx:if="{{isLoading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <view class="summary-items" wx:if="{{summaries.length > 0}}">
      <view class="summary-item" wx:for="{{summaries}}" wx:key="id" bindtap="viewDetail" data-id="{{item.summary_id}}">
        <view class="item-header">
          <text class="hospital-name">{{item.hospital || '未知医院'}}</text>
          <text class="visit-date">{{item.visit_date}}</text>
        </view>
        <view class="item-body">
          <view class="diagnosis-row">
            <text class="label">诊断：</text>
            <text class="value">{{item.diagnosis || '未识别'}}</text>
          </view>
          <view class="tags-row" wx:if="{{item.prescription && item.prescription.medicines}}">
            <view class="tag" wx:for="{{item.prescription.medicines}}" wx:key="name" wx:for-item="med">
              {{med.name}}
            </view>
          </view>
        </view>
        <view class="item-footer">
          <text class="view-more">查看详情 ></text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:elif="{{!isLoading}}">
      <view class="empty-icon">📝</view>
      <text>暂无就诊摘要记录</text>
    </view>
  </view>
</view>

<!-- AI助手小窗 -->
<floating-ai-btn agent-type="summary" />