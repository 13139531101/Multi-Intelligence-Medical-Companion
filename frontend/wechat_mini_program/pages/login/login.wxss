/* login.wxss */
.container {
  padding: 40rpx;
  min-height: 100vh;
  background: var(--primary-gradient);
  display: flex;
  flex-direction: column;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
  margin-top: 100rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 800;
  color: white;
  display: block;
  margin-bottom: 24rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.subtitle {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  font-weight: 500;
}

.api-status {
  text-align: center;
  margin-bottom: 40rpx;
}

.status-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 30rpx;
  backdrop-filter: blur(10px);
}

.form-container {
  background: white;
  border-radius: var(--border-radius-lg);
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.2);
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: var(--text-main);
  display: block;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.input {
  width: 100%;
  height: 90rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: var(--border-radius-md);
  padding: 0 30rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  transition: all 0.3s;
  background: #f9f9f9;
}

.input:focus {
  border-color: var(--primary-color);
  background: white;
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.1);
}

.login-btn {
  width: 100%;
  height: 90rpx;
  background: var(--primary-gradient);
  border: none;
  border-radius: var(--border-radius-md);
  color: white;
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 50rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(0, 122, 255, 0.2);
}

.login-btn[disabled] {
  background: #ccc;
  box-shadow: none;
}

.register-link {
  text-align: center;
  margin-top: 40rpx;
}

.link-text {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
}
