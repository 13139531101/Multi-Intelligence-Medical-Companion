.floating-ai-btn {
  position: fixed;
  right: 30rpx;
  bottom: 180rpx; /* Adjusted to be above TabBar */
  width: 110rpx;
  height: 110rpx;
  background: #007AFF;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.4);
  z-index: 1000;
  transition: all 0.3s ease;
}

.floating-ai-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.3);
}

.floating-icon {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 4rpx;
}

.floating-text {
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
}