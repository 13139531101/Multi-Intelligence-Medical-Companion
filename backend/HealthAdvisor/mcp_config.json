{
  "mcpServers": {
    "KnowledgeTool": {
      "command": "python",
      "args": [
        "mcpserver/knowledge_tool.py"
      ],
      "cwd": "/app/HealthAdvisor"
    },
    "DiagnosisTool": {
      "command": "python",
      "args": [
        "mcpserver/diagnosis_tool.py"
      ],
      "cwd": "/app/HealthAdvisor"
    },
    "DatabaseTool": {
      "command": "python",
      "args": [
        "mcpserver/database_tool.py"
      ],
      "cwd": "/app/HealthAdvisor",
      "env": {
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_USER": "pha",
        "DB_PASSWORD": "pha_pass",
        "DB_NAME": "personal_health_assistant"
      }
    },
    "MemoryIntegrationTool": {
      "command": "python",
      "args": [
        "mcpserver/memory_integration_tool.py"
      ],
      "cwd": "/app/HealthAdvisor",
      "env": {
        "MEMORY_DB_HOST": "localhost",
        "MEMORY_DB_PORT": "3306",
        "MEMORY_DB_NAME": "agent_memory",
        "MEMORY_DB_USER": "root",
        "MEMORY_DB_PASSWORD": "root",
        "EMBEDDING_MODEL": "all-MiniLM-L6-v2",
        "MEMORY_ENCRYPTION_ENABLED": "false"
      }
    }
  }
}
