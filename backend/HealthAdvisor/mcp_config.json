{
  "mcpServers": {
    "KnowledgeTool": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "mcp",
        "run",
        "mcpserver/knowledge_tool.py"
      ]
    },
    "DiagnosisTool": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "mcp",
        "run",
        "mcpserver/diagnosis_tool.py"
      ]
    },
    "MemoryIntegrationTool": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "--with",
        "mysql-connector-python",
        "--with",
        "cryptography",
        "mcpserver/memory_integration_tool.py"
      ],
      "env": {
        "MEMORY_DB_HOST": "localhost",
        "MEMORY_DB_PORT": "3306",
        "MEMORY_DB_NAME": "agent_memory",
        "MEMORY_DB_USER": "root",
        "MEMORY_DB_PASSWORD": "root",
        "EMBEDDING_MODEL": "all-MiniLM-L6-v2",
        "MEMORY_ENCRYPTION_ENABLED": "false"
      }
    }
  }
}
