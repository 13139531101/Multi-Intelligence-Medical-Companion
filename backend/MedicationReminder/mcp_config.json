{
  "mcpServers": {
    "ReminderTool": {
      "command": "python",
      "args": [
        "mcpserver/reminder_tool.py"
      ],
      "cwd": "/app/MedicationReminder",
      "env": {
        "PG_DSN": "postgresql://pha:pha_pass@postgres:5432/personal_health_assistant",
        "DATABASE_URL": "postgresql://pha:pha_pass@postgres:5432/personal_health_assistant",
        "MEMORY_DATABASE_URL": "postgresql://pha:pha_pass@postgres:5432/personal_health_assistant"
      }
    },
    "NotificationTool": {
      "command": "python",
      "args": [
        "mcpserver/notification_tool.py"
      ],
      "cwd": "/app/MedicationReminder",
      "env": {
        "PG_DSN": "postgresql://pha:pha_pass@postgres:5432/personal_health_assistant",
        "DATABASE_URL": "postgresql://pha:pha_pass@postgres:5432/personal_health_assistant",
        "MEMORY_DATABASE_URL": "postgresql://pha:pha_pass@postgres:5432/personal_health_assistant"
      }
    },
    "MemoryIntegrationTool": {
      "command": "python",
      "args": [
        "memory_integration_tool.py"
      ],
      "cwd": "/app/MedicationReminder",
      "env": {
        "DATABASE_URL": "sqlite:///medication_reminder_memory.db",
        "EMBEDDING_MODEL": "text-embedding-3-small",
        "LOG_LEVEL": "INFO"
      }
    }
  }
}
