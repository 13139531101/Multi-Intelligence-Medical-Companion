{
  "mcpServers": {
    "OCRTool": {
      "command": "python",
      "args": [
        "mcpserver/ocr_tool.py"
      ],
      "cwd": "/app/HealthRecordsManager",
      "env": {
        "OCR_PROVIDER": "local",
        "OCR_LANG": "chi_sim+eng",
        "TESSERACT_PATH": "C\\\\Program Files\\\\Tesseract-OCR\\\\tesseract.exe",
        "TESSDATA_PREFIX": "C\\\\Program Files\\\\Tesseract-OCR\\\\tessdata"
      }
    },
    "DataExtractionTool": {
      "command": "python",
      "args": [
        "mcpserver/data_extraction_tool.py"
      ],
      "cwd": "/app/HealthRecordsManager"
    },
    "StorageTool": {
      "command": "python",
      "args": [
        "mcpserver/storage_tool.py"
      ],
      "cwd": "/app/HealthRecordsManager"
    },
    "ReminderTool": {
      "command": "python",
      "args": [
        "mcpserver/reminder_tool.py"
      ],
      "cwd": "/app/HealthRecordsManager"
    },
    "MemoryIntegrationTool": {
      "command": "python",
      "args": [
        "mcpserver/memory_integration_tool.py"
      ],
      "cwd": "/app/HealthRecordsManager",
      "env": {
        "MEMORY_DB_HOST": "postgres",
        "MEMORY_DB_PORT": "5432",
        "MEMORY_DB_NAME": "personal_health_assistant",
        "MEMORY_DB_USER": "pha",
        "MEMORY_DB_PASSWORD": "pha_pass",
        "MEMORY_EMBEDDING_MODEL": "all-MiniLM-L6-v2",
        "MEMORY_LOG_LEVEL": "INFO"
      }
    }
  }
}
