{
  "mcpServers": {
    "OCRTool": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "--with",
        "alibabacloud-ocr20191230",
        "--with",
        "alibabacloud-ocr-api20210707",
        "--with",
        "alibabacloud-tea-openapi",
        "--with",
        "alibabacloud-tea-util",
        "--with",
        "Pillow",
        "--with",
        "pytesseract",
        "--with",
        "requests",
        "--with",
        "python-dotenv",
        "mcpserver/ocr_tool.py"
      ],
      "cwd": "HealthRecordsManager",
      "env": {
        "OCR_PROVIDER": "local",
        "OCR_LANG": "chi_sim+eng",
        "TESSERACT_PATH": "C\\\\Program Files\\\\Tesseract-OCR\\\\tesseract.exe",
        "TESSDATA_PREFIX": "C\\\\Program Files\\\\Tesseract-OCR\\\\tessdata"
      }
    },
    "DataExtractionTool": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "mcpserver/data_extraction_tool.py"
      ],
      "cwd": "HealthRecordsManager"
    },
    "StorageTool": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "--with",
        "mysql-connector-python",
        "--with",
        "cryptography",
        "mcpserver/storage_tool.py"
      ],
      "cwd": "HealthRecordsManager"
    },
    "ReminderTool": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "--with",
        "mysql-connector-python",
        "mcpserver/reminder_tool.py"
      ],
      "cwd": "HealthRecordsManager"
    },
    "MemoryIntegrationTool": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "--with",
        "mysql-connector-python",
        "--with",
        "cryptography",
        "mcpserver/memory_integration_tool.py"
      ],
      "cwd": "HealthRecordsManager",
      "env": {
        "MEMORY_DB_HOST": "localhost",
        "MEMORY_DB_PORT": "3306",
        "MEMORY_DB_NAME": "agent_memory",
        "MEMORY_DB_USER": "root",
        "MEMORY_DB_PASSWORD": "root",
        "MEMORY_EMBEDDING_MODEL": "all-MiniLM-L6-v2",
        "MEMORY_LOG_LEVEL": "INFO"
      }
    }
  }
}
